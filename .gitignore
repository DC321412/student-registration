# Ignore directories generated by Composer
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Ignore sensitive and site-specific files
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.yml
/web/sites/*/services.local.yml

# Ignore Drupal's file directory and SQLite database
/web/sites/*/files/
/web/sites/*/private/
/web/default/files/
/web/default/
*.sqlite*
*.sqlite3*
.ht.sqlite*

# OS & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
