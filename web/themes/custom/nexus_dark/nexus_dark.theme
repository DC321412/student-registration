<?php

/**
 * @file
 * Functions to support theming in the Nexus Dark theme.
 */

use Drupal\Core\Url;

/**
 * Implements hook_preprocess_html().
 */
function nexus_dark_preprocess_html(&$variables) {
  $variables['attributes']['class'][] = 'nexus-dark-theme';
  $variables['attributes']['class'][] = 'futuristic-dark';

  try {
    if (\Drupal::service('path.matcher')->isFrontPage()) {
      $variables['attributes']['class'][] = 'is-frontpage';
    }
  }
  catch (\Exception $e) {
    // Fallback if path.matcher not available yet.
  }
}

/**
 * Implements hook_preprocess_page().
 */
function nexus_dark_preprocess_page(&$variables) {
  $site_config = \Drupal::config('system.site');
  $variables['site_name'] = $site_config->get('name') ?: 'Student Nexus';
  $variables['site_slogan'] = $site_config->get('slogan') ?: 'Academic Intelligence Portal';
  $variables['current_year'] = date('Y');

  // Check current path for active navigation states.
  $current_path = \Drupal::service('path.current')->getPath();
  $variables['current_path'] = $current_path;

  // Provide direct URLs for easy fallback rendering in custom header/footer.
  $variables['url_home'] = Url::fromRoute('<front>')->toString();
  $variables['url_register'] = Url::fromRoute('student_registration.register')->toString();
  $variables['url_directory'] = '/students';
  $variables['url_admin_content'] = '/admin/content';
}

/**
 * Implements hook_preprocess_block().
 */
function nexus_dark_preprocess_block(&$variables) {
  $variables['attributes']['class'][] = 'nexus-block';
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function nexus_dark_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $suggestions[] = 'page__front';
  }
}
